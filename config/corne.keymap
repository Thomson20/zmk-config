#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip {
    chain-length = <27>;
};

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | LWR |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '  |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC |
//                    | LWR3| RSE | ENT |   | SPC | BSPC | ALT | 
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &mo 1 
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                &mo 3   &mo 2  &kp RET      &kp SPACE &kp BSPC &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 |      |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT | RGB | REFF|     |     |     |   |     |     |     |     |     |      |
//                    |     |     | SPC |   | ENT | GUI | ALT |
                        bindings = <
   &kp TAB    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &kp F6   &kp F7   &kp F8 &kp F9    &kp F10 &trans 
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans  &trans
   &kp LSHFT  &rgb_ug RGB_TOG      &rgb_ug RGB_EFF       &trans       &trans       &trans         &trans   &trans   &trans  &trans    &trans &trans
                                   &trans     &trans       &kp SPACE      &kp RET  &kp LGUI   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------

// |   _  | =   |  7  |  8  |  9  |  %  |   |  &  |  *  |  (  |  ) |  { |  }  |
// |      |  +  |  4  |  5  |  6  |     |   |  $  |  %  |  ^  |  # |  [ |  ]  |
// |      |  -  |  1  |  2  |  3  |   0 |   |  !  |  @  |  £  |  ) | "|"|  ~  |
//                    | ESC |     | ENT |   | SPC | BSPC | ALT | 
                        bindings = <
   &kp UNDER &kp EQUAL &kp N7  &kp N8   &kp N9  &kp PRCNT    &kp AMPS  &kp ASTRK  &kp LPAR &kp RPAR  &kp LBRC &kp RBRC
   &trans    &kp PLUS  &kp N4  &kp N5   &kp N6   &trans      &kp DLLR  &kp PRCNT  &kp CARET &kp HASH &kp LBKT &kp RBKT
   &trans    &kp MINUS &kp N1  &kp N2   &kp N3   &kp N0      &kp EXCL  &kp AT     &kp HASH  &kp RBRC &kp PIPE &kp TILDE
                              &kp ESC  &mo 1    &kp RET      &kp SPACE &kp BSPC &kp RALT
                        >;
                };
                mouse_layer {
// -----------------------------------------------------------------------------------------
// | TAB  |      |      |      |      |      |   |      |      |      |      |      | BSPC |
// |      |      |      |      |      |      |   | LEFT | DOWN |  UP  | RIGHT|      |      |
// |      |      |      |      |      |      |   | SCR← | SCR↓ | SCR↑ | SCR→ |      |      |
//                    |      |      | SPACE|   | LCLK | RCLK | MCLK |
// -----------------------------------------------------------------------------------------
                         bindings = <
        &kp TAB  &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &kp BSPC
        &trans   &trans &trans &trans &trans &trans      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans &trans
        &trans   &trans &trans &trans &trans &trans      &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &trans &trans
                            &trans   &trans &kp SPACE    &mkp LCLK &mkp RCLK &mkp MCLK
                        >;
                };
        };
};


