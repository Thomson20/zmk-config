#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip {
    chain-length = <27>;
};

&lt {
    tapping-term-ms = <300>; // This is the value already set by default
};

/ {
        keymap {
                compatible = "zmk,keymap";

               default_layer {
// -----------------------------------------------------------------------------------------
// |  GUI |  Q  |  W  |  E      |  R        |  T    |   |  Y  |  U   |  I  |  O  |  P  | LWR4|
// | CTRL |  A  |  S  |  D      |  F        |  G    |   |  H  |  J   |  K  |  L  |  ;  |  '  |
// | SHFT |  Z  |  X  |  C      |  V        |  B    |   |  N  |  M   |  ,  |  .  |  /  | ALT |
//                    | LWR3/ESC| RSE/SPACE |LWR/TAB|   | ENT | BSPC | DEL |
                        bindings = <
   &kp LGUI  &kp Q &kp W &kp E &kp R &kp T      &kp Y &kp U  &kp I     &kp O   &kp P    &to 4
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G      &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B      &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp LALT
        &lt 3 ESC   &lt 2 SPACE  &lt 1 TAB      &kp RET &kp BSPC &kp DEL
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  GUI |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 | BTCLR|
// | CTRL | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     | PRS  |
// | SHFT | RGB | REFF|     |     |     |   |     |     |     |     |CAPNL| CWORD|
//                      |ESC|SPACE|     |   | ENT | BSPC | DEL |
                        bindings = <
   &kp LGUI   &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &kp F6   &kp F7   &kp F8 &kp F9    &kp F10 &bt BT_CLR  
   &kp LCTRL  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans  &kp LS(LG(N5))
   &kp LSHFT  &rgb_ug RGB_TOG      &rgb_ug RGB_EFF       &trans       &trans       &trans         &trans   &trans   &trans  &trans   &kt CAPS &caps_word
                                    &kp ESC   &kp SPACE  &trans     &kp RET &kp BSPC &kp DEL
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------

// |  GUI | =   |  7  |  8  |  9  |  %  |   |  &  |  *  |  (  |  ) |  { |  }  |
// | CTRL |  +  |  4  |  5  |  6  |   _  |   |  $  |  %  |  ^  |  # |  [ |  ]  |
// | SHFT |  -  |  1  |  2  |  3  |   0 |   |  !  |  @  |  £  |  ) | "|"|  ~  |
//                    | ESC |     | ENT |   | SPC | BSPC | ALT | 
                        bindings = <
   &kp LGUI   &kp EQUAL &kp N7  &kp N8   &kp N9  &kp PRCNT    &kp AMPS  &kp ASTRK  &kp LPAR &kp RPAR  &kp LBRC &kp RBRC
   &kp LCTRL &kp PLUS  &kp N4  &kp N5   &kp N6   &kp UNDER      &kp DLLR  &kp PRCNT  &kp CARET &kp HASH &kp LBKT &kp RBKT
   &kp LSHFT &kp MINUS &kp N1  &kp N2   &kp N3   &kp N0      &kp EXCL  &kp AT     &kp HASH  &kp RBRC &kp PIPE &kp TILDE
                              &kp ESC  &mo 1    &kp RET      &kp SPACE &kp BSPC &kp RALT
                        >;
                };
                mouse_layer {
// -----------------------------------------------------------------------------------------
// |  GUI |      |      |      |      |      |   |      |      |      |      |      | BSPC |
// | CTRL |  TAB | ALT  |  CTR | SHIFT|      |   | LEFT | DOWN |  UP  | RIGHT|      |      |
// | SHFT |      |      |      |      |      |   | SCR← | SCR↓ | SCR↑ | SCR→ |      |      |
//                    |      |      | SPACE|   | LCLK | RCLK | MCLK |
// -----------------------------------------------------------------------------------------
                         bindings = <
        &kp LGUI   &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &kp BSPC
        &kp LCTRL  &kp TAB &kp LALT &kp LCTRL &kp LSHFT &trans      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans &trans
        &kp LSHFT  &trans &trans &trans &trans &trans      &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &trans &trans
                            &trans   &trans &kp SPACE    &mkp LCLK &mkp RCLK &mkp MCLK
                        >;
                };
                valheim_layer {
// -----------------------------------------------------------------------------------------
// | ESC  |  1  |  W  |  2  |  3  |  4  |   |      |      |      |      |      | LWR0 |
// | TAB  |  A  |  S  |  D  |  F  |  5  |   |      |      |      |      |      |      |
// | CTRL |  6  |  7  |  8  |  M  |  R  |   |      |      |      |      |      |      |
//                    | SHFT|  E | SPACE|   |      |      |      |
// -----------------------------------------------------------------------------------------
    bindings = <
        &kp ESC   &kp N1 &kp W  &kp N2 &kp N3 &kp N4    &none &none &none &none &none &to 0
        &kp TAB   &kp A  &kp S  &kp D  &kp F  &kp N5    &none &none &none &none &none &none
        &kp LCTRL &kp N6 &kp N7 &kp N8 &kp M  &kp R     &none &none &none &none &none &none
                         &kp LSHFT &kp E &kp SPACE     &none &none &none
                       >;
                };
        };
};
